# Offline Linux build for the EasyTunnel rendezvous server.
# Usage: make -f Makefile.rendezvous
# Builds both the plain server and its FTXUI TUI by default; `make rendezvous`
# builds only the former if FTXUI is not available.

CXX ?= g++
TARGET ?= EasyTunnel_rendezvous
TUI_TARGET ?= EasyTunnel_rendezvous_tui
BUILD_DIR ?= build-rendezvous

CPPFLAGS ?=
CXXFLAGS ?= -O2 -DNDEBUG
CXXFLAGS += -std=c++17 -Wall -Wextra -Wpedantic -pthread
LDFLAGS ?=
LDLIBS ?= -pthread

CORE_SOURCES := rendezvous/server.cpp rendezvous/registry.cpp \
                rendezvous/ipv4_relay_app.cpp rendezvous/config.cpp \
                nat_protocol.cpp secure_random.cpp util.cpp config.cpp easy_log.cpp
SOURCES := rendezvous/main.cpp $(CORE_SOURCES)
OBJECTS := $(SOURCES:%.cpp=$(BUILD_DIR)/%.o)
TUI_SOURCES := rendezvous/tui_main.cpp rendezvous/tui_app.cpp \
               rendezvous/tui_dashboard.cpp rendezvous/tui_relay_tab.cpp \
               rendezvous/tui_config_tab.cpp \
               rendezvous/tui_log_tab.cpp $(CORE_SOURCES)
TUI_OBJECTS := $(TUI_SOURCES:%.cpp=$(BUILD_DIR)/%.o)
DEPFILES := $(sort $(OBJECTS:.o=.d) $(TUI_OBJECTS:.o=.d))

FTXUI_CFLAGS := $(shell pkg-config --cflags ftxui 2>/dev/null)
FTXUI_LIBS := $(shell pkg-config --libs ftxui 2>/dev/null)
JSONCPP_CFLAGS := $(shell pkg-config --cflags jsoncpp 2>/dev/null)
JSONCPP_LIBS := $(shell pkg-config --libs jsoncpp 2>/dev/null)

# rendezvous/config.cpp always needs JsonCpp, so every object picks up its
# flags; FTXUI stays scoped to the TUI objects since only that build needs it.
CPPFLAGS += $(JSONCPP_CFLAGS)
LDLIBS += $(JSONCPP_LIBS)

.PHONY: all clean rendezvous rendezvous_tui check-jsoncpp check-ftxui

all: $(TARGET) $(TUI_TARGET)

rendezvous: $(TARGET)

rendezvous_tui: $(TUI_TARGET)

check-jsoncpp:
	@pkg-config --exists jsoncpp || { \
		echo "JsonCpp was not found. Install its development package first, e.g.:"; \
		echo "  Debian/Ubuntu: sudo apt install libjsoncpp-dev"; \
		echo "  Fedora:        sudo dnf install jsoncpp-devel"; \
		echo "  Arch:          sudo pacman -S jsoncpp"; \
		exit 1; \
	}

check-ftxui:
	@pkg-config --exists ftxui || { \
		echo "FTXUI was not found. It is rarely packaged by distros, so build and install it from source first:"; \
		echo "  git clone --branch v6.1.9 https://github.com/ArthurSonzogni/FTXUI.git"; \
		echo "  cmake -S FTXUI -B FTXUI/build -DCMAKE_BUILD_TYPE=Release -DFTXUI_ENABLE_INSTALL=ON"; \
		echo "  cmake --build FTXUI/build --target install"; \
		exit 1; \
	}

$(TARGET): check-jsoncpp $(OBJECTS)
	$(CXX) $(LDFLAGS) $(OBJECTS) $(LDLIBS) -o $@

$(TUI_TARGET): check-jsoncpp check-ftxui $(TUI_OBJECTS)
	$(CXX) $(LDFLAGS) $(TUI_OBJECTS) $(FTXUI_LIBS) $(LDLIBS) -o $@

$(TUI_OBJECTS): CPPFLAGS += $(FTXUI_CFLAGS)

$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c $< -o $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET) $(TUI_TARGET)

-include $(DEPFILES)

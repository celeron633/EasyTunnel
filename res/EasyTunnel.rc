// Windows application icons. The lowest-id resource remains the icon Explorer
// uses for the executable; the other states are selected at runtime.
#include "resource.h"

IDI_EASYTUNNEL              ICON "EasyTunnel.ico"
IDI_EASYTUNNEL_DISCONNECTED ICON "IconSets/EasyTunnelDisconnected.ico"
IDI_EASYTUNNEL_RX           ICON "IconSets/EasyTunnelRx.ico"
IDI_EASYTUNNEL_TX           ICON "IconSets/EasyTunnelTx.ico"
IDI_EASYTUNNEL_RX_TX        ICON "IconSets/EasyTunnelRxTx.ico"
